# URL publique du site, utilisee pour le SEO (canonical, sitemap, JSON-LD)
# ex: https://viliahazo.org — par defaut https://viliahazo.org
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings > API)
# URL publique du projet, ex: https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Cle publique "anon"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cle secrete "service_role" (UNIQUEMENT cote serveur, ne jamais exposer)
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------------------------
# Configuration S3 (Optionnelle si vous utilisez Supabase Storage natif)
# Supabase S3 Protocol :
# -------------------------------------------------------------
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=eu-central-1
# S3_BUCKET=images
# S3_ENDPOINT=https://qitqyaghipsmpgzqocac.storage.supabase.co/storage/v1/s3
# S3_PUBLIC_URL=https://qitqyaghipsmpgzqocac.supabase.co/storage/v1/object/public/images
# S3_FORCE_PATH_STYLE=true

# Secret de signature des sessions (generer: openssl rand -hex 32)
AUTH_SECRET=

# Compte administrateur (Mairie) cree automatiquement a la connexion
ADMIN_EMAIL=beny@viliahazo.org
# A changer avant toute mise en ligne : donne acces a /admin
ADMIN_PASSWORD=changez-moi
